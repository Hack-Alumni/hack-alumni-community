{
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "config/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "turbo run build --cache-dir=.turbo",

    "build:render": "yarn workspace @hackcommunity/member-profile build && yarn build:api",
    "build:api": "cd apps/api && yarn build",
    "db:migrate": "yarn workspace @hackcommunity/db migrate",
    "db:migrate:down": "yarn workspace @hackcommunity/db migrate:down",
    "db:migration:create": "yarn workspace @hackcommunity/db migration:create",
    "db:seed": "yarn workspace @hackcommunity/db seed",
    "db:types": "yarn workspace @hackcommunity/db types",
    "dev": "turbo run dev --cache-dir=.turbo",
    "dev:apps": "yarn dev --filter=./apps/*",
    "dev:setup": "./scripts/dev-setup.sh",
    "dx:down": "docker compose down",
    "dx:nuke": "docker compose down --volumes --remove-orphans",
    "dx:up": "docker compose up -d",
    "env:setup": "yarn workspace @hackcommunity/scripts env:setup",
    "lint": "turbo run lint --cache-dir=.turbo",
    "lint:fix": "turbo run lint:fix --cache-dir=.turbo",
    "prisma:setup": "yarn workspace @hackcommunity/scripts prisma:setup",
    "prisma:studio": "yarn workspace @hackcommunity/db prisma:studio",
    "qstash:setup": "tsx scripts/setup-qstash-schedules.ts",
    "start": "turbo run start --cache-dir=.turbo",

    "start:render": "yarn workspace @hackcommunity/member-profile start",
    "start:api:render": "yarn workspace @hackcommunity/api start",
    "start:cron:render": "yarn workspace @hackcommunity/api start:cron",
    "test": "turbo run test --cache-dir=.turbo",
    "type-check": "turbo run type-check --cache-dir=.turbo",

    "clean": "turbo run clean --cache-dir=.turbo",
    "clean:all": "rm -rf node_modules && rm -rf apps/*/node_modules && rm -rf packages/*/node_modules && rm -rf config/*/node_modules && yarn install"
  },
  "dependencies": {
    "ioredis": "^5.7.0",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "latest",
    "typescript": "5.8.3"
  },
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@1.22.10"
}
